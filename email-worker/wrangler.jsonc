{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eu-learn-upcoming-courses-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "ep.europa.kiwi/EU.Learn.UpcomingCourses*",
      "zone_name": "europa.kiwi"
    }
  ],
  "vars": {
    "GITHUB_OWNER": "modulow",
    "GITHUB_REPO": "EU.Learn.UpcomingCourses",
    "GITHUB_BRANCH": "main",
    "GITHUB_DATA_PATH": "public/data/courses.json",
    "ALLOWED_RECIPIENT": "learn-it@ep.europa.kiwi"
  }
}
